# Cache lunga per gli asset statici serviti da Netlify (migliora "cache lifetimes" su PSI).
# NB: se sostituisci un file mantenendo lo stesso nome, aggiungi/incrementa un ?v=N nel
# riferimento in index.html — come gia' fatto per le favicon (es. favicon.png?v=3).
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable
/assets/audio/*
  Cache-Control: public, max-age=31536000, immutable

# styles.css viene rigenerato dalla build Tailwind e non e' hashato: cache piu' breve.
/assets/styles.css
  Cache-Control: public, max-age=604800
